<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Runs only the scenarios that failed in the previous run (after their in-run retries, see rerun.count
  in config.properties). They are read from target/cucumber-reports/rerun.txt, so do not run "mvn clean" in between:
      mvn test -Dsuite.xml=testng-rerun.xml
  Parallel execution, thread count and retries come from config.properties, as for testng.xml.
-->
<suite name="Web Automation Suite - Failed Scenarios" verbose="1">
    <test name="Failed Cucumber Scenarios">
        <classes>
            <class name="com.example.runner.FailedScenariosRunner"/>
        </classes>
    </test>
</suite>
